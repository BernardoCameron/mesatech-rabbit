# Copia a ".env" y cambia las claves. NUNCA subas ".env" al repositorio.

# Administrador del broker (panel en el puerto 15672)
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=cambiar_clave_admin

# Usuarios de las aplicaciones (se crean a mano en el panel, ver README)
CATALOGO_PUBLICADOR_PASSWORD=cambiar_clave_publicador
SOLICITUDES_CONSUMIDOR_PASSWORD=cambiar_clave_consumidor
